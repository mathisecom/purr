{% liquid
  assign sid = section.id | replace: '_', '' | downcase
%}

<section
  id="Comparison-{{ section.id }}"
  class="cecp cecp--{{ sid }}"
  style="
    --cecp-bg: {{ section.settings.section_background }};
    --cecp-left-bg: {{ section.settings.left_background }};
    --cecp-right-bg: {{ section.settings.right_background }};
    --cecp-left-text: {{ section.settings.left_text_color }};
    --cecp-right-text: {{ section.settings.right_text_color }};
    --cecp-left-icon: {{ section.settings.left_icon_color }};
    --cecp-right-icon: {{ section.settings.right_icon_color }};
    --cecp-divider-left: {{ section.settings.left_divider_color }};
    --cecp-divider-right: {{ section.settings.right_divider_color }};
    --cecp-border: {{ section.settings.border_color }};
    --cecp-max-width: {{ section.settings.max_width }}px;
    --cecp-radius: {{ section.settings.border_radius }}px;
    --cecp-title-size: {{ section.settings.title_size_desktop }}px;
    --cecp-text-size: {{ section.settings.text_size_desktop }}px;
    --cecp-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --cecp-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --cecp-section-top: {{ section.settings.padding_top }}px;
    --cecp-section-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cecp__shell">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <header class="cecp__header">
        {% if section.settings.eyebrow != blank %}
          <p class="cecp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="cecp__main-heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="cecp__card">
      <div class="cecp__column cecp__column--left">
        <div class="cecp__top">
          <div class="cecp__media cecp__media--left">
            {% if section.settings.left_image != blank %}
              {{ section.settings.left_image
                | image_url: width: 700
                | image_tag:
                  widths: '160, 240, 320, 480, 640, 700',
                  sizes: '(max-width: 749px) 36vw, 260px',
                  loading: 'lazy',
                  class: 'cecp__image',
                  alt: section.settings.left_image.alt | default: section.settings.left_title
              }}
            {% else %}
              <div class="cecp__patch-placeholder" aria-hidden="true">
                <span></span><span></span>
              </div>
            {% endif %}
          </div>
          <h3 class="cecp__title">{{ section.settings.left_title | escape }}</h3>
        </div>

        <div class="cecp__rows">
          {% for block in section.blocks %}
            <div class="cecp__row" {{ block.shopify_attributes }}>
              <span class="cecp__icon cecp__icon--cross" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </span>
              <div class="cecp__copy">{{ block.settings.left_text }}</div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="cecp__column cecp__column--right">
        <div class="cecp__top cecp__top--right">
          <div class="cecp__media cecp__media--right">
            {% if section.settings.right_image != blank %}
              {{ section.settings.right_image
                | image_url: width: 700
                | image_tag:
                  widths: '160, 240, 320, 480, 640, 700',
                  sizes: '(max-width: 749px) 36vw, 260px',
                  loading: 'lazy',
                  class: 'cecp__image',
                  alt: section.settings.right_image.alt | default: section.settings.right_title
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'cecp__placeholder-svg' }}
            {% endif %}
          </div>
          <h3 class="cecp__title">{{ section.settings.right_title | escape }}</h3>
        </div>

        <div class="cecp__rows">
          {% for block in section.blocks %}
            <div class="cecp__row" {{ block.shopify_attributes }}>
              <span class="cecp__icon cecp__icon--check" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img"><path d="M5 12.5l4.2 4.2L19 7"/></svg>
              </span>
              <div class="cecp__copy">{{ block.settings.right_text }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #Comparison-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: var(--cecp-bg);
    padding-block: var(--cecp-section-top) var(--cecp-section-bottom);
  }

  #Comparison-{{ section.id }} * {
    box-sizing: border-box;
  }

  #Comparison-{{ section.id }} .cecp__shell {
    width: 100%;
    max-width: calc(var(--cecp-max-width) + 40px);
    margin: 0 auto;
    padding-inline: 20px;
    min-width: 0;
  }

  #Comparison-{{ section.id }} .cecp__header {
    max-width: 760px;
    margin: 0 auto 28px;
    text-align: center;
  }

  #Comparison-{{ section.id }} .cecp__eyebrow {
    margin: 0 0 8px;
    color: var(--cecp-right-bg);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #Comparison-{{ section.id }} .cecp__main-heading {
    margin: 0;
    color: var(--cecp-left-text);
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.12;
  }

  #Comparison-{{ section.id }} .cecp__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    width: 100%;
    max-width: var(--cecp-max-width);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--cecp-border);
    border-radius: var(--cecp-radius);
    background: var(--cecp-left-bg);
  }

  #Comparison-{{ section.id }} .cecp__column {
    min-width: 0;
    padding: 30px 56px 28px;
  }

  #Comparison-{{ section.id }} .cecp__column--left {
    background: var(--cecp-left-bg);
    color: var(--cecp-left-text);
  }

  #Comparison-{{ section.id }} .cecp__column--right {
    background: var(--cecp-right-bg);
    color: var(--cecp-right-text);
  }

  #Comparison-{{ section.id }} .cecp__top {
    display: grid;
    grid-template-columns: minmax(130px, 220px) minmax(0, 1fr);
    align-items: center;
    gap: 22px;
    min-height: 118px;
    margin-bottom: 8px;
  }

  #Comparison-{{ section.id }} .cecp__media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 110px;
  }

  #Comparison-{{ section.id }} .cecp__image,
  #Comparison-{{ section.id }} .cecp__placeholder-svg {
    display: block;
    width: 100%;
    max-width: 190px;
    height: 100%;
    object-fit: contain;
  }

  #Comparison-{{ section.id }} .cecp__title {
    min-width: 0;
    margin: 0;
    color: inherit;
    font-size: var(--cecp-title-size);
    line-height: 1.08;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  #Comparison-{{ section.id }} .cecp__rows {
    min-width: 0;
  }

  #Comparison-{{ section.id }} .cecp__row {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    min-width: 0;
    padding: 18px 0;
  }

  #Comparison-{{ section.id }} .cecp__column--left .cecp__row:not(:last-child) {
    border-bottom: 1px solid var(--cecp-divider-left);
  }

  #Comparison-{{ section.id }} .cecp__column--right .cecp__row:not(:last-child) {
    border-bottom: 1px solid var(--cecp-divider-right);
  }

  #Comparison-{{ section.id }} .cecp__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  #Comparison-{{ section.id }} .cecp__icon svg {
    display: block;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #Comparison-{{ section.id }} .cecp__icon--cross {
    color: var(--cecp-left-icon);
  }

  #Comparison-{{ section.id }} .cecp__icon--check {
    color: var(--cecp-right-icon);
  }

  #Comparison-{{ section.id }} .cecp__copy {
    min-width: 0;
    color: inherit;
    font-size: var(--cecp-text-size);
    line-height: 1.45;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  #Comparison-{{ section.id }} .cecp__copy p {
    margin: 0;
  }

  #Comparison-{{ section.id }} .cecp__patch-placeholder {
    position: relative;
    width: 150px;
    height: 95px;
  }

  #Comparison-{{ section.id }} .cecp__patch-placeholder span {
    position: absolute;
    left: 50%;
    width: 82px;
    height: 42px;
    transform: translateX(-50%) rotate(-4deg);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    background: linear-gradient(180deg, #f8f9fa 0%, #e6eaec 100%);
    box-shadow: 0 8px 14px rgba(46, 67, 71, .08);
  }

  #Comparison-{{ section.id }} .cecp__patch-placeholder span:first-child { top: 6px; }
  #Comparison-{{ section.id }} .cecp__patch-placeholder span:last-child { top: 52px; left: 58%; }

  @media screen and (max-width: 989px) {
    #Comparison-{{ section.id }} .cecp__column {
      padding: 28px 28px 24px;
    }

    #Comparison-{{ section.id }} .cecp__top {
      grid-template-columns: 1fr;
      gap: 10px;
      text-align: center;
    }

    #Comparison-{{ section.id }} .cecp__media {
      height: 100px;
    }

    #Comparison-{{ section.id }} .cecp__image,
    #Comparison-{{ section.id }} .cecp__placeholder-svg {
      max-width: 150px;
    }
  }

  @media screen and (max-width: 749px) {
    #Comparison-{{ section.id }} {
      --cecp-section-top: {{ section.settings.padding_top_mobile }}px;
      --cecp-section-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #Comparison-{{ section.id }} .cecp__shell {
      max-width: 100%;
      padding-inline: {{ section.settings.mobile_side_padding }}px;
    }

    #Comparison-{{ section.id }} .cecp__header {
      margin-bottom: 20px;
      padding-inline: 6px;
    }

    #Comparison-{{ section.id }} .cecp__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      width: 100%;
      max-width: 100%;
      border-radius: min(var(--cecp-radius), 22px);
    }

    #Comparison-{{ section.id }} .cecp__column {
      min-width: 0;
      padding: 20px 10px 16px;
    }

    #Comparison-{{ section.id }} .cecp__top {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      min-height: 148px;
      gap: 8px;
      margin-bottom: 0;
      text-align: center;
    }

    #Comparison-{{ section.id }} .cecp__media {
      width: 100%;
      height: 88px;
    }

    #Comparison-{{ section.id }} .cecp__image,
    #Comparison-{{ section.id }} .cecp__placeholder-svg {
      width: 100%;
      max-width: 118px;
      height: 88px;
    }

    #Comparison-{{ section.id }} .cecp__patch-placeholder {
      transform: scale(.78);
      transform-origin: center;
    }

    #Comparison-{{ section.id }} .cecp__title {
      width: 100%;
      font-size: var(--cecp-title-size-mobile);
      line-height: 1.12;
      text-align: center;
    }

    #Comparison-{{ section.id }} .cecp__row {
      grid-template-columns: 17px minmax(0, 1fr);
      align-items: center;
      gap: 8px;
      min-height: 80px;
      padding: 12px 0;
    }

    #Comparison-{{ section.id }} .cecp__icon {
      width: 17px;
      height: 17px;
    }

    #Comparison-{{ section.id }} .cecp__icon svg {
      width: 16px;
      height: 16px;
    }

    #Comparison-{{ section.id }} .cecp__copy {
      font-size: var(--cecp-text-size-mobile);
      line-height: 1.32;
      text-align: center;
      hyphens: auto;
    }
  }

  @media screen and (max-width: 390px) {
    #Comparison-{{ section.id }} .cecp__column {
      padding-inline: 7px;
    }

    #Comparison-{{ section.id }} .cecp__row {
      grid-template-columns: 15px minmax(0, 1fr);
      gap: 5px;
    }

    #Comparison-{{ section.id }} .cecp__icon,
    #Comparison-{{ section.id }} .cecp__icon svg {
      width: 14px;
      height: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Comparatif Eye Patches",
  "tag": "section",
  "class": "section-comparatif-eye-patches",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "En-tête facultatif"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit texte",
      "default": "Pourquoi choisir nos patchs ?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de la section",
      "default": "La différence se voit dès la première utilisation"
    },
    {
      "type": "header",
      "content": "Colonne de gauche"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Image des patchs ordinaires"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Titre gauche",
      "default": "Patchs contour des yeux ordinaires"
    },
    {
      "type": "header",
      "content": "Colonne de droite"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Image de votre produit"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Titre droit",
      "default": "Collagen Eye Patches"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Fond de la section",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "left_background",
      "label": "Fond gauche",
      "default": "#EEF2F3"
    },
    {
      "type": "color",
      "id": "right_background",
      "label": "Fond droit",
      "default": "#003049"
    },
    {
      "type": "color",
      "id": "left_text_color",
      "label": "Texte gauche",
      "default": "#2E4347"
    },
    {
      "type": "color",
      "id": "right_text_color",
      "label": "Texte droit",
      "default": "#EEF2F3"
    },
    {
      "type": "color",
      "id": "left_icon_color",
      "label": "Croix",
      "default": "#D95D50"
    },
    {
      "type": "color",
      "id": "right_icon_color",
      "label": "Coches",
      "default": "#22D3A7"
    },
    {
      "type": "color",
      "id": "left_divider_color",
      "label": "Séparateurs gauche",
      "default": "#D8E0E2"
    },
    {
      "type": "color",
      "id": "right_divider_color",
      "label": "Séparateurs droite",
      "default": "#60777D"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bordure extérieure",
      "default": "#D8D3C9"
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 16,
      "max": 42,
      "step": 1,
      "unit": "px",
      "label": "Titres — ordinateur",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Textes — ordinateur",
      "default": 17
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 13,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Titres — mobile",
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Textes — mobile",
      "default": 13
    },
    {
      "type": "header",
      "content": "Dimensions et espacements"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 700,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "label": "Largeur maximale",
      "default": 1160
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Arrondi",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Marge haute — ordinateur",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Marge basse — ordinateur",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Marge haute — mobile",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Marge basse — mobile",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Marge latérale — mobile",
      "default": 11
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Ligne de comparaison",
      "settings": [
        {
          "type": "richtext",
          "id": "left_text",
          "label": "Texte gauche",
          "default": "<p>Reste à la surface de la peau</p>"
        },
        {
          "type": "richtext",
          "id": "right_text",
          "label": "Texte droit",
          "default": "<p>Une action ciblée au contact du contour des yeux</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparatif Eye Patches",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "<p>Reste à la surface de la peau</p>",
            "right_text": "<p>Patchs hydrogel confortables qui épousent le contour des yeux</p>"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "<p>Peut sembler lourd sous les yeux</p>",
            "right_text": "<p>Texture légère, fraîche et agréable à porter</p>"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "<p>Hydratation basique uniquement</p>",
            "right_text": "<p>Formule enrichie en collagène pour une peau visiblement plus lisse</p>"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "<p>Peu de différence visible dès la première utilisation</p>",
            "right_text": "<p>Aide à réveiller et illuminer le regard dès l'application</p>"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "<p>Les poches restent souvent inchangées</p>",
            "right_text": "<p>Aide à réduire visiblement l'apparence des poches et des cernes</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
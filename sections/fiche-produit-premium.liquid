{% comment %}
  Shopify OS 2.0 section — Responsive premium product page with typography settings
  Place in: sections/premium-product-page.liquid
{% endcomment %}

{% liquid
  assign featured_product = product
  if featured_product == blank
    assign featured_product = section.settings.product
  endif

  if featured_product != blank
    assign current_variant = featured_product.selected_or_first_available_variant
    assign current_media = current_variant.featured_media | default: featured_product.featured_media
    assign product_form_id = 'PremiumProductForm-' | append: section.id
    assign first_allocation = current_variant.selling_plan_allocations.first
  endif
%}

<section
  id="PremiumProduct-{{ section.id }}"
  class="pfp"
  style="
    --pfp-bg: {{ section.settings.background_color }};
    --pfp-text: {{ section.settings.text_color }};
    --pfp-muted: {{ section.settings.muted_color }};
    --pfp-line: {{ section.settings.line_color }};
    --pfp-panel: {{ section.settings.panel_color }};
    --pfp-dark: {{ section.settings.dark_color }};
    --pfp-accent: {{ section.settings.accent_color }};
    --pfp-radius: {{ section.settings.corner_radius }}px;
    --pfp-top: {{ section.settings.padding_top }}px;
    --pfp-bottom: {{ section.settings.padding_bottom }}px;
    --pfp-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --pfp-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --pfp-body-size: {{ section.settings.body_text_size }}px;
    --pfp-small-size: {{ section.settings.small_text_size }}px;
    --pfp-button-size: {{ section.settings.button_text_size }}px;
    --pfp-video-title-desktop: {{ section.settings.video_title_size_desktop }}px;
    --pfp-video-title-mobile: {{ section.settings.video_title_size_mobile }}px;
    --pfp-video-card-width: {{ section.settings.video_card_width }}px;
    --pfp-video-mobile-width: {{ section.settings.video_mobile_width }}vw;
  "
>
  {% if featured_product == blank %}
    <div class="pfp__empty page-width">
      <h2>Select a product</h2>
      <p>Choose a product in this section’s settings.</p>
    </div>
  {% else %}
    <div class="pfp__container">
      <div class="pfp__gallery-column">
        <div class="pfp__gallery-sticky">
          <div class="pfp__main-media">
            {% if section.settings.promo_badge != blank %}
              <span class="pfp__promo">{{ section.settings.promo_badge }}</span>
            {% endif %}

            {% if current_media != blank %}
              <img
                id="PremiumProductImage-{{ section.id }}"
                class="pfp__main-image"
                src="{{ current_media.preview_image | image_url: width: 1200 }}"
                alt="{{ current_media.alt | default: featured_product.title | escape }}"
                width="{{ current_media.preview_image.width }}"
                height="{{ current_media.preview_image.height }}"
                loading="eager"
                fetchpriority="high"
              >
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'pfp__placeholder' }}
            {% endif %}
          </div>

          {% if featured_product.media.size > 1 %}
            <div class="pfp__thumbs" aria-label="Product gallery">
              {% for media in featured_product.media limit: 8 %}
                {% if media.preview_image != blank %}
                  <button
                    class="pfp__thumb{% if media.id == current_media.id %} is-active{% endif %}"
                    type="button"
                    data-full-image="{{ media.preview_image | image_url: width: 1200 }}"
                    data-alt="{{ media.alt | default: featured_product.title | escape }}"
                    aria-label="View image {{ forloop.index }}"
                    aria-pressed="{% if media.id == current_media.id %}true{% else %}false{% endif %}"
                  >
                    <img
                      src="{{ media.preview_image | image_url: width: 220 }}"
                      alt="{{ media.alt | default: featured_product.title | escape }}"
                      width="110"
                      height="110"
                      loading="lazy"
                    >
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="pfp__content">
        {% if section.settings.trust_text != blank or section.settings.trust_image != blank %}
          <div class="pfp__trust">
            {% if section.settings.trust_image != blank %}
              <img
                src="{{ section.settings.trust_image | image_url: width: 180 }}"
                alt=""
                width="90"
                height="32"
                loading="lazy"
              >
            {% endif %}
            <div class="pfp__trust-text">{{ section.settings.trust_text }}</div>
          </div>
        {% endif %}

        <h1 class="pfp__title">{{ featured_product.title }}</h1>

        <div class="pfp__intro rte">
          {% if section.settings.intro != blank %}
            {{ section.settings.intro }}
          {% else %}
            <p>{{ featured_product.description | strip_html | truncatewords: 70 }}</p>
          {% endif %}
        </div>

        {% if section.settings.show_rating %}
          <div class="pfp__rating" aria-label="Rated {{ section.settings.rating_value }} out of 5">
            <span class="pfp__stars" aria-hidden="true">★★★★★</span>
            <span>{{ section.settings.rating_value }} out of 5</span>
            {% if section.settings.review_count != blank %}
              <span>({{ section.settings.review_count }})</span>
            {% endif %}
          </div>
        {% endif %}

        {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}
        {% if benefit_blocks.size > 0 %}
          <div class="pfp__benefits">
            {% for block in benefit_blocks %}
              <div class="pfp__benefit" {{ block.shopify_attributes }}>
                <span class="pfp__benefit-icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'eye' %}
                      <svg viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="3"/></svg>
                    {% when 'sparkle' %}
                      <svg viewBox="0 0 24 24"><path d="m12 2 1.6 5.4L19 9l-5.4 1.6L12 16l-1.6-5.4L5 9l5.4-1.6L12 2Z"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/></svg>
                    {% when 'shield' %}
                      <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.8 8.1 7 10 4.2-1.9 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/></svg>
                    {% when 'face' %}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8.5 10h.01M15.5 10h.01M8.5 15c2 1.4 5 1.4 7 0"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>
                  {% endcase %}
                </span>
                <div>{{ block.settings.text }}</div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.clinician_title != blank or section.settings.clinician_text != blank %}
          <div class="pfp__clinician">
            <div class="pfp__clinician-heading">
              <span aria-hidden="true">⚕</span>
              <strong>{{ section.settings.clinician_title }}</strong>
            </div>
            <div class="pfp__clinician-body">
              {% if section.settings.clinician_image != blank %}
                <img
                  src="{{ section.settings.clinician_image | image_url: width: 120 }}"
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                >
              {% endif %}
              <div>{{ section.settings.clinician_text }}</div>
            </div>
          </div>
        {% endif %}

        {% form 'product', featured_product, id: product_form_id, class: 'pfp__form' %}
          <input type="hidden" name="quantity" value="1">

          {% if featured_product.selling_plan_groups.size > 0 %}
            <div class="pfp__purchase-tabs" role="group" aria-label="Purchase option">
              <button class="pfp__purchase-tab is-active" type="button" data-mode="onetime" aria-pressed="true">
                {{ section.settings.one_time_label }}
              </button>
              <button class="pfp__purchase-tab" type="button" data-mode="subscribe" aria-pressed="false">
                {{ section.settings.subscribe_label }}
              </button>
            </div>
            <input
              class="pfp__selling-plan-input"
              type="hidden"
              name="selling_plan"
              value="{% if first_allocation != blank %}{{ first_allocation.selling_plan.id }}{% endif %}"
              disabled
            >
          {% endif %}

          <div class="pfp__variant-list" role="radiogroup" aria-label="Choose an option">
            {% for variant in featured_product.variants %}
              {% liquid
                assign allocation = variant.selling_plan_allocations.first
                assign variant_media = variant.featured_media | default: featured_product.featured_media
                assign onetime_saving = 0
                if variant.compare_at_price > variant.price
                  assign onetime_saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                endif
                assign subscribe_saving = 0
                if allocation != blank and allocation.compare_at_price > allocation.price
                  assign subscribe_saving = allocation.compare_at_price | minus: allocation.price | times: 100.0 | divided_by: allocation.compare_at_price | round
                endif
              %}
              <label
                class="pfp__variant-card{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-disabled{% endunless %}"
                data-variant-card
                data-onetime-price="{{ variant.price | money | escape }}"
                data-onetime-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                data-onetime-saving="{{ onetime_saving }}"
                data-subscribe-price="{% if allocation != blank %}{{ allocation.price | money | escape }}{% endif %}"
                data-subscribe-compare="{% if allocation != blank and allocation.compare_at_price > allocation.price %}{{ allocation.compare_at_price | money | escape }}{% endif %}"
                data-subscribe-saving="{{ subscribe_saving }}"
                data-selling-plan-id="{% if allocation != blank %}{{ allocation.selling_plan.id }}{% endif %}"
                data-image="{% if variant_media != blank %}{{ variant_media.preview_image | image_url: width: 1200 }}{% endif %}"
                data-image-alt="{{ variant_media.alt | default: featured_product.title | escape }}"
                data-available="{{ variant.available }}"
              >
                {% if forloop.index == section.settings.popular_variant_position %}
                  <span class="pfp__popular">{{ section.settings.popular_badge }}</span>
                {% endif %}

                <input
                  type="radio"
                  name="id"
                  value="{{ variant.id }}"
                  {% if variant.id == current_variant.id %}checked{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >

                <span class="pfp__radio-dot" aria-hidden="true"></span>

                {% if variant_media != blank %}
                  <img
                    class="pfp__variant-image"
                    src="{{ variant_media.preview_image | image_url: width: 140 }}"
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                  >
                {% endif %}

                <span class="pfp__variant-info">
                  <strong>{{ variant.title }}</strong>
                  {% if variant.sku != blank %}<small>{{ variant.sku }}</small>{% endif %}
                </span>

                <span class="pfp__variant-price">
                  <strong data-card-price>
                    {% if variant.id == current_variant.id %}{{ variant.price | money }}{% else %}{{ variant.price | money }}{% endif %}
                  </strong>
                  <del data-card-compare>{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}</del>
                  <small data-card-saving>{% if onetime_saving > 0 %}Save {{ onetime_saving }}%{% endif %}</small>
                </span>
              </label>
            {% endfor %}
          </div>

          {% if section.settings.guarantee_line != blank %}
            <div class="pfp__guarantee-line">{{ section.settings.guarantee_line }}</div>
          {% endif %}

          <button
            class="pfp__add-button"
            type="submit"
            name="add"
            data-add-button
            data-label="{{ section.settings.button_label | escape }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-add-text>
              {% if current_variant.available %}
                {{ section.settings.button_label }} · {{ current_variant.price | money }}
              {% else %}
                {{ section.settings.sold_out_label }}
              {% endif %}
            </span>
          </button>

          {% if section.settings.show_payment_icons %}
            <div class="pfp__payments" aria-label="Accepted payment methods">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'pfp__payment-icon' }}
              {% endfor %}
            </div>
          {% endif %}
        {% endform %}

        {% if section.settings.moneyback_text != blank %}
          <div class="pfp__moneyback">
            <span class="pfp__moneyback-seal" aria-hidden="true">{{ section.settings.moneyback_days }}<small>DAYS</small></span>
            <div>{{ section.settings.moneyback_text }}</div>
          </div>
        {% endif %}

        {% assign accordion_blocks = section.blocks | where: 'type', 'accordion' %}
        {% if accordion_blocks.size > 0 %}
          <div class="pfp__faq">
            {% if section.settings.accordion_heading != blank %}
              <p class="pfp__faq-label">{{ section.settings.accordion_heading }}</p>
            {% endif %}

            {% for block in accordion_blocks %}
              <details class="pfp__accordion" {{ block.shopify_attributes }} {% if block.settings.open_by_default %}open{% endif %}>
                <summary>
                  <span>{{ block.settings.heading }}</span>
                  <span class="pfp__accordion-icon" aria-hidden="true"></span>
                </summary>
                <div class="pfp__accordion-content rte">{{ block.settings.content }}</div>
              </details>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    {% assign video_blocks = section.blocks | where: 'type', 'video_testimonial' %}
    {% if section.settings.show_video_slider and video_blocks.size > 0 %}
      <div class="pfp__video-showcase" aria-labelledby="PremiumVideoHeading-{{ section.id }}">
        {% if section.settings.video_heading != blank %}
          <h2 id="PremiumVideoHeading-{{ section.id }}" class="pfp__video-heading">
            {{ section.settings.video_heading }}
          </h2>
        {% endif %}
        <div class="pfp__video-track" data-video-track tabindex="0" aria-label="Customer video reviews">
          {% for block in video_blocks %}
            {% liquid
              assign customer_video = block.settings.video
              assign video_poster = block.settings.cover_image
              if video_poster == blank and customer_video != blank
                assign video_poster = customer_video.preview_image
              endif
            %}

            <article class="pfp__video-card" data-video-card {{ block.shopify_attributes }}>
              <div class="pfp__video-media">
                {% if customer_video != blank %}
                  <video
                    class="pfp__customer-video"
                    playsinline
                    preload="metadata"
                    {% if video_poster != blank %}poster="{{ video_poster | image_url: width: 900 }}"{% endif %}
                    aria-label="{{ block.settings.accessible_label | default: 'Customer review video' | escape }}"
                  >
                    {% for source in customer_video.sources %}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                  </video>

                  <button
                    class="pfp__video-play"
                    type="button"
                    data-video-play
                    aria-label="Play video"
                  >
                    <span aria-hidden="true"></span>
                  </button>
                {% elsif video_poster != blank %}
                  <img
                    class="pfp__video-poster"
                    src="{{ video_poster | image_url: width: 900 }}"
                    alt="{{ block.settings.accessible_label | escape }}"
                    width="{{ video_poster.width }}"
                    height="{{ video_poster.height }}"
                    loading="lazy"
                  >
                  <span class="pfp__video-play pfp__video-play--placeholder" aria-hidden="true"><span></span></span>
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'pfp__video-placeholder' }}
                  <span class="pfp__video-play pfp__video-play--placeholder" aria-hidden="true"><span></span></span>
                {% endif %}

                {% if block.settings.caption != blank %}
                  <div class="pfp__video-caption">{{ block.settings.caption }}</div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

        <div class="pfp__video-progress" aria-hidden="true">
          <span data-video-progress></span>
        </div>
      </div>
    {% endif %}
  {% endif %}
</section>

<style>
  #PremiumProduct-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    background: var(--pfp-bg);
    color: var(--pfp-text);
    padding: var(--pfp-top) 20px var(--pfp-bottom);
    overflow-x: hidden;
    overflow-x: clip;
  }

  #PremiumProduct-{{ section.id }} *,
  #PremiumProduct-{{ section.id }} *::before,
  #PremiumProduct-{{ section.id }} *::after { box-sizing: border-box; }

  #PremiumProduct-{{ section.id }} .pfp__container,
  #PremiumProduct-{{ section.id }} .pfp__gallery-column,
  #PremiumProduct-{{ section.id }} .pfp__gallery-sticky,
  #PremiumProduct-{{ section.id }} .pfp__content,
  #PremiumProduct-{{ section.id }} .pfp__form,
  #PremiumProduct-{{ section.id }} .pfp__variant-list {
    min-width: 0;
    max-width: 100%;
  }

  #PremiumProduct-{{ section.id }} img,
  #PremiumProduct-{{ section.id }} svg {
    max-width: 100%;
  }

  #PremiumProduct-{{ section.id }} .pfp__container {
    width: min(100%, 1180px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(420px, .92fr);
    gap: clamp(28px, 4vw, 54px);
    align-items: start;
  }

  #PremiumProduct-{{ section.id }} .pfp__gallery-sticky {
    position: sticky;
    top: 24px;
  }

  #PremiumProduct-{{ section.id }} .pfp__main-media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--pfp-radius);
    background: var(--pfp-panel);
  }

  #PremiumProduct-{{ section.id }} .pfp__main-image,
  #PremiumProduct-{{ section.id }} .pfp__placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #PremiumProduct-{{ section.id }} .pfp__promo {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 14px;
    padding: 6px 10px;
    border-radius: 5px;
    color: #fff;
    background: var(--pfp-dark);
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
  }

  #PremiumProduct-{{ section.id }} .pfp__thumbs {
    display: grid;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    grid-auto-flow: column;
    grid-auto-columns: minmax(76px, 1fr);
    gap: 10px;
    margin-top: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    padding-bottom: 4px;
  }

  #PremiumProduct-{{ section.id }} .pfp__thumb {
    appearance: none;
    width: 100%;
    min-width: 76px;
    aspect-ratio: 1 / 1;
    padding: 0;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: calc(var(--pfp-radius) * .65);
    background: var(--pfp-panel);
    cursor: pointer;
  }

  #PremiumProduct-{{ section.id }} .pfp__thumb.is-active {
    border-color: var(--pfp-dark);
    box-shadow: inset 0 0 0 1px var(--pfp-dark);
  }

  #PremiumProduct-{{ section.id }} .pfp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #PremiumProduct-{{ section.id }} .pfp__content { min-width: 0; }

  #PremiumProduct-{{ section.id }} .pfp__trust-text,
  #PremiumProduct-{{ section.id }} .pfp__title,
  #PremiumProduct-{{ section.id }} .pfp__intro,
  #PremiumProduct-{{ section.id }} .pfp__benefit > div,
  #PremiumProduct-{{ section.id }} .pfp__clinician-body > div,
  #PremiumProduct-{{ section.id }} .pfp__variant-info,
  #PremiumProduct-{{ section.id }} .pfp__moneyback > div,
  #PremiumProduct-{{ section.id }} .pfp__accordion summary > span:first-child,
  #PremiumProduct-{{ section.id }} .pfp__accordion-content {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  #PremiumProduct-{{ section.id }} .pfp__trust {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    font-size: var(--pfp-small-size);
  }

  #PremiumProduct-{{ section.id }} .pfp__trust img {
    width: auto;
    height: 30px;
    object-fit: contain;
    flex: 0 0 auto;
  }

  #PremiumProduct-{{ section.id }} .pfp__trust-text p { margin: 0; }

  #PremiumProduct-{{ section.id }} .pfp__title {
    margin: 0 0 12px;
    color: var(--pfp-text);
    font-size: var(--pfp-title-size-desktop);
    line-height: .98;
    letter-spacing: -.035em;
    font-weight: 700;
  }

  #PremiumProduct-{{ section.id }} .pfp__intro {
    color: var(--pfp-text);
    font-size: var(--pfp-body-size);
    line-height: 1.55;
  }

  #PremiumProduct-{{ section.id }} .pfp__intro p:first-child { margin-top: 0; }
  #PremiumProduct-{{ section.id }} .pfp__intro p:last-child { margin-bottom: 0; }

  #PremiumProduct-{{ section.id }} .pfp__rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 14px;
    font-size: var(--pfp-small-size);
  }

  #PremiumProduct-{{ section.id }} .pfp__stars {
    color: #ffad32;
    letter-spacing: 1px;
    font-size: 18px;
    line-height: 1;
  }

  #PremiumProduct-{{ section.id }} .pfp__benefits {
    margin: 18px 0 0;
    padding: 14px 0;
    border-top: 1px solid var(--pfp-line);
    border-bottom: 1px solid var(--pfp-line);
  }

  #PremiumProduct-{{ section.id }} .pfp__benefit {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 9px;
    align-items: start;
    padding: 8px 4px;
    font-size: var(--pfp-body-size);
    line-height: 1.4;
  }

  #PremiumProduct-{{ section.id }} .pfp__benefit-icon {
    width: 20px;
    height: 20px;
    color: var(--pfp-muted);
  }

  #PremiumProduct-{{ section.id }} .pfp__benefit-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #PremiumProduct-{{ section.id }} .pfp__clinician {
    padding: 13px 0;
    border-bottom: 1px solid var(--pfp-line);
  }

  #PremiumProduct-{{ section.id }} .pfp__clinician-heading {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
    font-size: var(--pfp-body-size);
  }

  #PremiumProduct-{{ section.id }} .pfp__clinician-body {
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--pfp-muted);
    font-size: var(--pfp-small-size);
    line-height: 1.45;
  }

  #PremiumProduct-{{ section.id }} .pfp__clinician-body p { margin: 0; }

  #PremiumProduct-{{ section.id }} .pfp__clinician-body img {
    width: 42px;
    height: 42px;
    object-fit: cover;
    border-radius: 50%;
  }

  #PremiumProduct-{{ section.id }} .pfp__form { margin-top: 14px; }

  #PremiumProduct-{{ section.id }} .pfp__purchase-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--pfp-line);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
  }

  #PremiumProduct-{{ section.id }} .pfp__purchase-tab {
    min-height: 42px;
    padding: 9px 12px;

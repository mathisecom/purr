</style>

<script>
  (() => {
    const root = document.getElementById('PremiumProduct-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const mainImage = root.querySelector('#PremiumProductImage-{{ section.id }}');
    const thumbButtons = [...root.querySelectorAll('.pfp__thumb')];
    const variantCards = [...root.querySelectorAll('[data-variant-card]')];
    const modeButtons = [...root.querySelectorAll('[data-mode]')];
    const sellingPlanInput = root.querySelector('.pfp__selling-plan-input');
    const addButton = root.querySelector('[data-add-button]');
    const addText = root.querySelector('[data-add-text]');
    const soldOutLabel = {{ section.settings.sold_out_label | json }};
    const videoTrack = root.querySelector('[data-video-track]');
    const videoProgress = root.querySelector('[data-video-progress]');
    const videoPlayButtons = [...root.querySelectorAll('[data-video-play]')];
    let purchaseMode = 'onetime';

    const selectedCard = () => root.querySelector('[data-variant-card] input[name="id"]:checked')?.closest('[data-variant-card]');

    const setMainImage = (url, alt = '') => {
      if (!mainImage || !url) return;
      mainImage.src = url;
      mainImage.alt = alt;
    };

    const updateCardPrices = () => {
      variantCards.forEach((card) => {
        const price = purchaseMode === 'subscribe' && card.dataset.subscribePrice
          ? card.dataset.subscribePrice
          : card.dataset.onetimePrice;
        const compare = purchaseMode === 'subscribe'
          ? card.dataset.subscribeCompare
          : card.dataset.onetimeCompare;
        const saving = purchaseMode === 'subscribe'
          ? card.dataset.subscribeSaving
          : card.dataset.onetimeSaving;

        const priceNode = card.querySelector('[data-card-price]');
        const compareNode = card.querySelector('[data-card-compare]');
        const savingNode = card.querySelector('[data-card-saving]');

        if (priceNode) priceNode.textContent = price || '';
        if (compareNode) compareNode.textContent = compare || '';
        if (savingNode) savingNode.textContent = Number(saving) > 0 ? `Save ${saving}%` : '';
      });
    };

    const updateForm = () => {
      const card = selectedCard();
      if (!card) return;

      variantCards.forEach((item) => item.classList.toggle('is-selected', item === card));

      const hasSubscription = Boolean(card.dataset.sellingPlanId && card.dataset.subscribePrice);
      if (purchaseMode === 'subscribe' && !hasSubscription) {
        purchaseMode = 'onetime';
        modeButtons.forEach((button) => {
          const active = button.dataset.mode === 'onetime';
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        });
      }

      if (sellingPlanInput) {
        if (purchaseMode === 'subscribe' && hasSubscription) {
          sellingPlanInput.disabled = false;
          sellingPlanInput.value = card.dataset.sellingPlanId;
        } else {
          sellingPlanInput.disabled = true;
          sellingPlanInput.value = '';
        }
      }

      const price = purchaseMode === 'subscribe' && hasSubscription
        ? card.dataset.subscribePrice
        : card.dataset.onetimePrice;
      const available = card.dataset.available === 'true';

      if (addButton && addText) {
        addButton.disabled = !available;
        addText.textContent = available
          ? `${addButton.dataset.label} · ${price}`
          : soldOutLabel;
      }

      setMainImage(card.dataset.image, card.dataset.imageAlt);
      updateCardPrices();
    };

    thumbButtons.forEach((button) => {
      button.addEventListener('click', () => {
        thumbButtons.forEach((item) => {
          item.classList.remove('is-active');
          item.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('is-active');
        button.setAttribute('aria-pressed', 'true');
        setMainImage(button.dataset.fullImage, button.dataset.alt);
      });
    });

    variantCards.forEach((card) => {
      const input = card.querySelector('input[name="id"]');
      if (!input) return;
      input.addEventListener('change', updateForm);
    });

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        purchaseMode = button.dataset.mode;
        modeButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        updateForm();
      });
    });

    const updateVideoProgress = () => {
      if (!videoTrack || !videoProgress) return;

      const maxScroll = Math.max(0, videoTrack.scrollWidth - videoTrack.clientWidth);
      const visibleRatio = Math.min(1, videoTrack.clientWidth / Math.max(videoTrack.scrollWidth, 1));
      const thumbPercent = Math.max(14, visibleRatio * 100);
      const travelPercent = 100 - thumbPercent;
      const scrollRatio = maxScroll > 0 ? videoTrack.scrollLeft / maxScroll : 0;

      videoProgress.style.width = `${thumbPercent}%`;
      videoProgress.style.transform = `translateX(${scrollRatio * travelPercent / (thumbPercent / 100)}%)`;
    };

    if (videoTrack) {
      videoTrack.addEventListener('scroll', updateVideoProgress, { passive: true });
      window.addEventListener('resize', updateVideoProgress, { passive: true });
      requestAnimationFrame(updateVideoProgress);
    }

    videoPlayButtons.forEach((button) => {
      const card = button.closest('[data-video-card]');
      const video = card?.querySelector('video');
      if (!video) return;

      const setPlayingState = (playing) => {
        card.classList.toggle('is-playing', playing);
        button.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
      };

      const toggleVideo = () => {
        if (video.paused) {
          root.querySelectorAll('.pfp__customer-video').forEach((otherVideo) => {
            if (otherVideo !== video) otherVideo.pause();
          });
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      };

      button.addEventListener('click', toggleVideo);
      video.addEventListener('click', toggleVideo);
      video.addEventListener('play', () => setPlayingState(true));
      video.addEventListener('pause', () => setPlayingState(false));
      video.addEventListener('ended', () => setPlayingState(false));
    });

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') {
        root.dataset.initialized = 'false';
      }
    });

    updateForm();
  })();
</script>


      "default": "800",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" },
        { "value": "900", "label": "Black" }
      ]
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading to text spacing",
      "min": 10,
      "max": 45,
      "step": 1,
      "default": 25,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "description_weight",
      "label": "Description weight",
      "default": "500",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" }
      ]
    },
    {
      "type": "range",
      "id": "description_width",
      "label": "Description width",
      "min": 260,
      "max": 560,
      "step": 10,
      "default": 470,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_bottom_spacing",
      "label": "Description to button spacing",
      "min": 18,
      "max": 50,
      "step": 1,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Avatar size",
      "min": 22,
      "max": 48,
      "step": 1,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "avatar_overlap",
      "label": "Avatar overlap",
      "min": 0,
      "max": 18,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Button width",
      "min": 220,
      "max": 520,
      "step": 10,
      "default": 470,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height",
      "min": 42,
      "max": 70,
      "step": 1,
      "default": 48,
      "unit": "px"
    },

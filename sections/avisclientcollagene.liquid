{% comment %}
  Section : Avis clients — Collagen Eye Patches
  Responsive PC / tablette / mobile, sans dépendance externe.
{% endcomment %}

{%- liquid
  assign section_id = 'cep-reviews-' | append: section.id
  assign card_count = section.blocks.size
-%}

<section
  id="{{ section_id }}"
  class="cep-reviews"
  data-section-id="{{ section.id }}"
  style="
    --cep-bg: {{ section.settings.background_color }};
    --cep-card-bg: {{ section.settings.card_background_color }};
    --cep-heading: {{ section.settings.heading_color }};
    --cep-text: {{ section.settings.text_color }};
    --cep-accent: {{ section.settings.accent_color }};
    --cep-secondary: {{ section.settings.secondary_color }};
    --cep-star: {{ section.settings.star_color }};
    --cep-radius: {{ section.settings.card_radius }}px;
    --cep-gap: {{ section.settings.card_gap }}px;
    --cep-max-width: {{ section.settings.max_width }}px;
    --cep-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --cep-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --cep-subtitle-desktop: {{ section.settings.subtitle_size_desktop }}px;
    --cep-subtitle-mobile: {{ section.settings.subtitle_size_mobile }}px;
    --cep-review-desktop: {{ section.settings.review_size_desktop }}px;
    --cep-review-mobile: {{ section.settings.review_size_mobile }}px;
    --cep-mobile-card-width: {{ section.settings.mobile_card_width }}vw;
    --cep-padding-top: {{ section.settings.padding_top }}px;
    --cep-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cep-reviews__inner">
    <header class="cep-reviews__header">
      {% if section.settings.rating_text != blank %}
        <div class="cep-reviews__summary" aria-label="{{ section.settings.rating_text | strip_html | escape }}">
          <span class="cep-reviews__summary-stars" aria-hidden="true">★★★★★</span>
          <div class="cep-reviews__summary-text">{{ section.settings.rating_text }}</div>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="cep-reviews__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <div class="cep-reviews__subtitle rte">{{ section.settings.subtitle }}</div>
      {% endif %}
    </header>

    {% if card_count > 0 %}
      <div class="cep-reviews__carousel" data-carousel>
        {% if section.settings.show_arrows %}
          <button
            class="cep-reviews__arrow cep-reviews__arrow--prev"
            type="button"
            aria-label="Avis précédent"
            data-prev
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}

        <div class="cep-reviews__viewport" data-viewport tabindex="0">
          <div class="cep-reviews__track" data-track>
            {% for block in section.blocks %}
              {%- liquid
                assign review_rating = block.settings.rating | default: 5
                assign image_alt = block.settings.image_alt | default: block.settings.customer_name
              -%}

              <article
                class="cep-review-card"
                data-card
                {{ block.shopify_attributes }}
              >
                <div class="cep-review-card__media cep-review-card__media--{{ section.settings.image_ratio }}">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '320, 480, 640, 800, 1000, 1200',
                        sizes: '(min-width: 990px) 31vw, (min-width: 750px) 46vw, 86vw',
                        alt: image_alt,
                        class: 'cep-review-card__image'
                    }}
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'cep-review-card__placeholder' }}
                  {% endif %}
                </div>

                <div class="cep-review-card__content">
                  <div class="cep-review-card__rating-row">
                    <div class="cep-review-card__stars" aria-label="{{ review_rating }} sur 5 étoiles">
                      {% for star in (1..5) %}
                        <span class="{% if star <= review_rating %}is-active{% endif %}" aria-hidden="true">★</span>
                      {% endfor %}
                    </div>

                    {% if block.settings.rating_label != blank %}
                      <span class="cep-review-card__rating-label">{{ block.settings.rating_label }}</span>
                    {% endif %}
                  </div>

                  {% if block.settings.review != blank %}
                    <blockquote class="cep-review-card__quote">{{ block.settings.review }}</blockquote>
                  {% endif %}

                  <footer class="cep-review-card__footer">
                    {% if block.settings.customer_name != blank %}
                      <span class="cep-review-card__name">{{ block.settings.customer_name }}</span>
                    {% endif %}

                    {% if block.settings.verified %}
                      <span class="cep-review-card__verified">
                        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                          <path d="M10 1.7 12 3l2.4-.1.9 2.2 2 1.3-.6 2.3.6 2.3-2 1.3-.9 2.2-2.4-.1-2 1.3-2-1.3-2.4.1-.9-2.2-2-1.3.6-2.3-.6-2.3 2-1.3.9-2.2L8 3l2-1.3Z" fill="currentColor"/>
                          <path d="m6.7 10 2 2 4.6-4.7" fill="none" stroke="white" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>{{ block.settings.verified_label }}</span>
                      </span>
                    {% endif %}
                  </footer>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.show_arrows %}
          <button
            class="cep-reviews__arrow cep-reviews__arrow--next"
            type="button"
            aria-label="Avis suivant"
            data-next
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}
      </div>

      {% if section.settings.show_dots and card_count > 1 %}
        <div class="cep-reviews__dots" data-dots aria-label="Navigation des avis">
          {% for block in section.blocks %}
            <button
              type="button"
              class="cep-reviews__dot{% if forloop.first %} is-active{% endif %}"
              aria-label="Afficher l’avis {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              data-dot="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="cep-reviews__empty">
        Ajoutez des blocs « Avis client » dans l’éditeur de thème.
      </div>
    {% endif %}
  </div>
</section>

<style>
  #{{ section_id }} {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: var(--cep-bg);
    color: var(--cep-heading);
    padding-top: var(--cep-padding-top);
    padding-bottom: var(--cep-padding-bottom);
  }

  #{{ section_id }},
  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .cep-reviews__inner {
    width: min(100%, var(--cep-max-width));
    max-width: 100%;
    margin: 0 auto;
    padding-inline: 28px;
  }

  #{{ section_id }} .cep-reviews__header {
    max-width: 820px;
    margin: 0 auto 34px;
    text-align: center;
  }

  #{{ section_id }} .cep-reviews__summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
    font-size: 13px;
    line-height: 1.3;
    color: var(--cep-heading);
  }

  #{{ section_id }} .cep-reviews__summary-stars,
  #{{ section_id }} .cep-review-card__stars {
    color: var(--cep-star);
    letter-spacing: 1px;
    white-space: nowrap;
  }

  #{{ section_id }} .cep-reviews__summary-stars {
    font-size: 16px;
    line-height: 1;
  }

  #{{ section_id }} .cep-reviews__summary-text p {
    margin: 0;
  }

  #{{ section_id }} .cep-reviews__summary-text strong {
    font-weight: 700;
  }

  #{{ section_id }} .cep-reviews__heading {
    margin: 0;
    color: var(--cep-heading);
    font-size: var(--cep-heading-desktop);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  #{{ section_id }} .cep-reviews__subtitle {
    max-width: 740px;
    margin: 14px auto 0;
    color: var(--cep-heading);
    font-size: var(--cep-subtitle-desktop);
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  #{{ section_id }} .cep-reviews__subtitle p {
    margin: 0;
  }

  #{{ section_id }} .cep-reviews__carousel {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-width: 0;
  }

  #{{ section_id }} .cep-reviews__viewport {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  #{{ section_id }} .cep-reviews__viewport::-webkit-scrollbar {
    display: none;
  }

  #{{ section_id }} .cep-reviews__track {
    display: flex;
    align-items: stretch;
    gap: var(--cep-gap);
    width: 100%;
    min-width: 0;
  }

  #{{ section_id }} .cep-review-card {
    flex: 0 0 calc((100% - (var(--cep-gap) * 2)) / 3);
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: var(--cep-radius);
    background: var(--cep-card-bg);
    color: var(--cep-text);
    border: 1px solid color-mix(in srgb, var(--cep-secondary) 16%, transparent);
  }

  #{{ section_id }} .cep-review-card__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: color-mix(in srgb, var(--cep-card-bg) 85%, var(--cep-secondary));
  }

  #{{ section_id }} .cep-review-card__media--landscape {
    aspect-ratio: 16 / 9;
  }

  #{{ section_id }} .cep-review-card__media--standard {
    aspect-ratio: 4 / 3;
  }

  #{{ section_id }} .cep-review-card__media--square {
    aspect-ratio: 1 / 1;
  }

  #{{ section_id }} .cep-review-card__image,
  #{{ section_id }} .cep-review-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section_id }} .cep-review-card__placeholder {
    color: color-mix(in srgb, var(--cep-secondary) 30%, transparent);
    background: color-mix(in srgb, var(--cep-card-bg) 88%, var(--cep-secondary));
  }

  #{{ section_id }} .cep-review-card__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    padding: 18px 20px 20px;
  }

  #{{ section_id }} .cep-review-card__rating-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
  }

  #{{ section_id }} .cep-review-card__stars {
    display: inline-flex;
    gap: 1px;
    font-size: 17px;
    line-height: 1;
  }

  #{{ section_id }} .cep-review-card__stars span:not(.is-active) {
    color: color-mix(in srgb, var(--cep-text) 20%, transparent);
  }

  #{{ section_id }} .cep-review-card__rating-label {
    font-size: 13px;
    line-height: 1.3;
    color: var(--cep-text);
    opacity: 0.78;
  }

  #{{ section_id }} .cep-review-card__quote {
    margin: 16px 0 28px;
    color: var(--cep-text);
    font-size: var(--cep-review-desktop);
    line-height: 1.45;
    font-style: italic;
    overflow-wrap: anywhere;
  }

  #{{ section_id }} .cep-review-card__quote p {
    margin: 0;
  }

  #{{ section_id }} .cep-review-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
  }

  #{{ section_id }} .cep-review-card__name {
    font-size: 14px;
    font-weight: 650;
    color: var(--cep-text);
  }

  #{{ section_id }} .cep-review-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--cep-accent);
    font-size: 13px;
    font-style: italic;
    white-space: nowrap;
  }

  #{{ section_id }} .cep-review-card__verified svg {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
  }

  #{{ section_id }} .cep-reviews__arrow {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--cep-heading) 72%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--cep-accent) 82%, transparent);
    color: var(--cep-heading);
    cursor: pointer;
    transition: opacity 180ms ease, transform 180ms ease, background 180ms ease;
  }

  #{{ section_id }} .cep-reviews__arrow:hover:not(:disabled) {
    transform: scale(1.05);
    background: var(--cep-accent);
  }

  #{{ section_id }} .cep-reviews__arrow:focus-visible,
  #{{ section_id }} .cep-reviews__dot:focus-visible,
  #{{ section_id }} .cep-reviews__viewport:focus-visible {
    outline: 2px solid var(--cep-heading);
    outline-offset: 3px;
  }

  #{{ section_id }} .cep-reviews__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  #{{ section_id }} .cep-reviews__arrow svg {
    width: 22px;
    height: 22px;
  }

  #{{ section_id }} .cep-reviews__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
  }

  #{{ section_id }} .cep-reviews__dot {
    width: 26px;
    height: 2px;
    padding: 0;
    border: 0;
    border-radius: 99px;
    background: color-mix(in srgb, var(--cep-heading) 28%, transparent);
    cursor: pointer;
    transition: width 180ms ease, background 180ms ease;
  }

  #{{ section_id }} .cep-reviews__dot.is-active {
    width: 48px;
    background: var(--cep-heading);
  }

  #{{ section_id }} .cep-reviews__empty {
    padding: 28px;
    border: 1px dashed color-mix(in srgb, var(--cep-heading) 45%, transparent);
    border-radius: var(--cep-radius);
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .cep-review-card {
      flex-basis: calc((100% - var(--cep-gap)) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: min(var(--cep-padding-top), 54px);
      padding-bottom: min(var(--cep-padding-bottom), 54px);
    }

    #{{ section_id }} .cep-reviews__inner {
      padding-inline: 18px;
    }

    #{{ section_id }} .cep-reviews__header {
      margin-bottom: 24px;
    }

    #{{ section_id }} .cep-reviews__summary {
      gap: 8px;
      margin-bottom: 18px;
      font-size: 14px;
    }

    #{{ section_id }} .cep-reviews__summary-stars {
      font-size: 20px;
    }

    #{{ section_id }} .cep-reviews__heading {
      font-size: var(--cep-heading-mobile);
      line-height: 1.05;
    }

    #{{ section_id }} .cep-reviews__subtitle {
      margin-top: 18px;
      font-size: var(--cep-subtitle-mobile);
      line-height: 1.35;
    }

    #{{ section_id }} .cep-reviews__carousel {
      display: block;
      width: 100%;
      min-width: 0;
    }

    #{{ section_id }} .cep-reviews__arrow {
      display: none;
    }

    #{{ section_id }} .cep-reviews__viewport {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 0;
      touch-action: pan-x;
      -webkit-overflow-scrolling: touch;
    }

    #{{ section_id }} .cep-reviews__track {
      width: max-content;
      max-width: none;
      gap: 14px;
    }

    #{{ section_id }} .cep-review-card {
      flex: 0 0 min(var(--cep-mobile-card-width), 360px);
      width: min(var(--cep-mobile-card-width), 360px);
      max-width: calc(100vw - 36px);
      scroll-snap-align: start;
    }

    #{{ section_id }} .cep-review-card__media--landscape,
    #{{ section_id }} .cep-review-card__media--standard {
      aspect-ratio: 4 / 3;
    }

    #{{ section_id }} .cep-review-card__content {
      padding: 17px 17px 18px;
    }

    #{{ section_id }} .cep-review-card__quote {
      margin: 16px 0 30px;
      font-size: var(--cep-review-mobile);
      line-height: 1.42;
    }

    #{{ section_id }} .cep-review-card__footer {
      align-items: flex-end;
    }

    #{{ section_id }} .cep-reviews__dots {
      margin-top: 22px;
      gap: 6px;
      overflow: hidden;
    }

    #{{ section_id }} .cep-reviews__dot {
      width: 28px;
    }

    #{{ section_id }} .cep-reviews__dot.is-active {
      width: 56px;
    }
  }

  @media screen and (max-width: 360px) {
    #{{ section_id }} .cep-reviews__inner {
      padding-inline: 14px;
    }

    #{{ section_id }} .cep-review-card {
      max-width: calc(100vw - 28px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .cep-reviews__viewport {
      scroll-behavior: auto;
    }

    #{{ section_id }} .cep-reviews__arrow,
    #{{ section_id }} .cep-reviews__dot {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById({{ section_id | json }});
    if (!root || root.dataset.carouselReady === 'true') return;
    root.dataset.carouselReady = 'true';

    const viewport = root.querySelector('[data-viewport]');
    const cards = Array.from(root.querySelectorAll('[data-card]'));
    const prevButton = root.querySelector('[data-prev]');
    const nextButton = root.querySelector('[data-next]');
    const dots = Array.from(root.querySelectorAll('[data-dot]'));

    if (!viewport || cards.length === 0) return;

    let currentIndex = 0;
    let scrollTimer;

    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const cardLeft = (index) => {
      const card = cards[index];
      return card ? card.offsetLeft : 0;
    };

    const closestCardIndex = () => {
      const left = viewport.scrollLeft;
      let closestIndex = 0;
      let closestDistance = Infinity;

      cards.forEach((card, index) => {
        const distance = Math.abs(card.offsetLeft - left);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const visibleCardCount = () => {
      if (!cards[0]) return 1;
      const cardWidth = cards[0].getBoundingClientRect().width;
      if (!cardWidth) return 1;
      return Math.max(1, Math.round(viewport.clientWidth / cardWidth));
    };

    const maxStartIndex = () => Math.max(0, cards.length - visibleCardCount());

    const updateControls = (index) => {
      currentIndex = clamp(index, 0, cards.length - 1);

      if (prevButton) prevButton.disabled = currentIndex <= 0;
      if (nextButton) nextButton.disabled = currentIndex >= maxStartIndex();

      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === currentIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-current', active ? 'true' : 'false');
      });
    };

    const goTo = (index, behavior = 'smooth') => {
      const targetIndex = clamp(index, 0, maxStartIndex());
      viewport.scrollTo({ left: cardLeft(targetIndex), behavior });
      updateControls(targetIndex);
    };

    prevButton?.addEventListener('click', () => goTo(currentIndex - 1));
    nextButton?.addEventListener('click', () => goTo(currentIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.dot || 0)));
    });

    viewport.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => updateControls(closestCardIndex()), 80);
    }, { passive: true });

    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(currentIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(currentIndex + 1);
      }
    });

    const onResize = () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => goTo(clamp(currentIndex, 0, maxStartIndex()), 'auto'), 100);
    };

    window.addEventListener('resize', onResize, { passive: true });
    updateControls(0);
  })();
</script>

{% schema %}
{
  "name": "Avis Collagen Eye Patches",
  "tag": "section",
  "class": "section-avis-collagen-eye-patches",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Note globale",
      "default": "<p>Noté <strong>4,8 / 5 ‘Excellent’</strong></p>"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre principal",
      "default": "Un regard visiblement plus frais"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "<p>Des clientes qui voulaient lisser et illuminer leur contour des yeux. Leurs impressions après avoir intégré nos Collagen Eye Patches à leur routine.</p>"
    },
    {
      "type": "header",
      "content": "Carrousel"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Afficher les flèches sur ordinateur",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Afficher les indicateurs",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Format des images",
      "default": "standard",
      "options": [
        { "value": "landscape", "label": "Paysage 16:9" },
        { "value": "standard", "label": "Standard 4:3" },
        { "value": "square", "label": "Carré 1:1" }
      ]
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 76,
      "max": 94,
      "step": 1,
      "unit": "vw",
      "label": "Largeur d’une carte sur mobile",
      "default": 88
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Espacement entre les cartes",
      "default": 24
    },
    {
      "type": "range",
